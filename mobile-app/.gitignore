# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# build artifacts
bundle.js

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12

# Sentry (contains an auth token — never commit)
android/sentry.properties
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# The android/ project is hand-maintained (manual local builds, not `expo prebuild`),
# so it's tracked in git — only its build artifacts and machine-specific files are excluded.
/android/build/
/android/app/build/
/android/app/.cxx/
/android/.gradle/
/android/local.properties

# No ios/ project is maintained (Android-only local builds); ignore it if one ever appears.
/ios

# Firebase client config (project-specific, not a secret but keep out of git)
google-services.json
